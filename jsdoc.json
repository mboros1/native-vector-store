{
  "source": {
    "include": ["index.js", "README.md"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "readme": "./README.md",
    "template": "templates/default",
    "encoding": "utf8"
  },
  "plugins": ["plugins/markdown"],
  "markdown": {
    "idInHeadings": true
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true,
    "default": {
      "outputSourceFiles": false,
      "includeDate": false
    }
  },
  "metadata": {
    "title": "native-vector-store API Documentation",
    "description": "High-performance vector store with SIMD optimization for MCP servers"
  }
}