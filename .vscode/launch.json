{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C++ test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/test_main",
            "args": ["${workspaceFolder}/out_embedded"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build C++ test"
        },
        {
            "name": "Rust: Debug nvs-packer",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--package", "nvs-packer", "--bin", "nvs-packer", "--no-default-features"],
                "filter": { "name": "nvs-packer", "kind": "bin" },
                "cwd": "${workspaceFolder}/rust"
            },
            "args": ["${workspaceFolder}/samples/json", "--out", "${workspaceFolder}/nvs-bundle"],
            "cwd": "${workspaceFolder}/rust",
            "env": {}
        },
        {
            "name": "Rust: Debug nvs-core tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--package", "nvs-core", "--", "--nocapture"],
                "cwd": "${workspaceFolder}/rust"
            },
            "cwd": "${workspaceFolder}/rust"
        },
        {
            "name": "Debug Node.js test",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/test/test_similarity_search.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Node.js addon"
        }
    ]
}
