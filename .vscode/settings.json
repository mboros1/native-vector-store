{
    "files.associations": {
        "*.h": "cpp",
        "*.cc": "cpp",
        "*.cpp": "cpp"
    },
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "C_Cpp.default.intelliSenseMode": "macos-clang-arm64",
    // show logs while wiring this up
    "testMate.cpp.log.logpanel": true,
    // simplest: tell it exactly where your exe is
    "testMate.cpp.test.executables": 
        "${workspaceFolder}/src/bin/test_*",
    // optional: auto-load on startup
    "testMate.cpp.discovery.loadOnStartup": true,

    // Rust - rust-analyzer configuration
    "rust-analyzer.cargo.features": "all",
    "rust-analyzer.cargo.allTargets": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.checkOnSave.command": "clippy",
    "rust-analyzer.checkOnSave.extraArgs": ["--workspace", "--tests"],
    "rust-analyzer.inlayHints.enable": true,
    "rust-analyzer.runnables.extraArgs": ["--workspace"],
    // Per-crate test code lenses
    "rust-analyzer.runnables.overrideCargo": null,
    // Prefer CodeLLDB for debugging
    "debug.allowBreakpointsEverywhere": true
}
